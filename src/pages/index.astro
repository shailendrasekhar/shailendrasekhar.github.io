---
import Base from '../layouts/Base.astro';
import HeroDashcam from '../components/HeroDashcam.astro';
import NewsList from '../components/NewsList.astro';
import PubList from '../components/PubList.astro';
import { site, social } from '../data/site';
import { publications } from '../data/publications';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  alternateName: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: 'PhD student',
  affiliation: { '@type': 'Organization', name: 'Robotics Research Center, IIIT Hyderabad', url: 'https://robotics.iiit.ac.in/' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Georgia' },
    { '@type': 'CollegeOrUniversity', name: 'GITAM University' },
  ],
  knowsAbout: ['Autonomous driving', 'Robotics', 'Perception', 'Motion planning', 'Reinforcement learning', 'Behavior trees'],
  sameAs: social.map((s) => s.href),
};
---
<Base jsonLd={person}>
  <!-- On wide screens a live 3D town plays behind the hero, and "Take the wheel" drives it in place.
       Phones get the line-drawn dashcam. -->
  <section class="town-hero" data-town-hero aria-labelledby="hero-name">
    <div class="town-stage" data-stage aria-hidden="true"></div>
    <div class="town-scrim" aria-hidden="true"></div>
    <div class="town-hud">
      <div class="hud hud-tl">
        <p class="speed"><span data-hud-speed>0</span><small>km/h</small></p>
        <p class="hud-line" data-hud-mode></p>
        <p class="hud-line" data-hud-signal></p>
      </div>
      <p class="hud hud-tr hud-line" data-hud-you></p>
      <div class="town-bar">
        <div class="acts" role="group" aria-label="Driving controls">
          <button type="button" class="toggle" data-act="auto" aria-pressed="false">Autopilot</button>
          <button type="button" class="toggle" data-act="cam">Camera</button>
          <button type="button" class="toggle" data-act="reset">Reset</button>
          <button type="button" class="toggle stop" data-act="exit" hidden>Stop driving</button>
        </div>
        <p class="meta keys"><kbd>↑</kbd><kbd>↓</kbd><kbd>←</kbd><kbd>→</kbd> or <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> drive · <kbd>Space</kbd> brake · <kbd>P</kbd> autopilot · <kbd>C</kbd> camera · <kbd>R</kbd> reset · <kbd>Esc</kbd> stop</p>
        <p class="hud-line hud-world" data-hud-world></p>
      </div>
      <div class="touch" aria-hidden="true">
        <div class="pad"><button type="button" data-touch="left" tabindex="-1">◀</button><button type="button" data-touch="right" tabindex="-1">▶</button></div>
        <div class="pad"><button type="button" data-touch="brake" tabindex="-1">Brake</button><button type="button" data-touch="gas" tabindex="-1">Go</button></div>
      </div>
    </div>
    <p class="toast" data-hud-toast role="status" hidden></p>
    <div class="hero wrap">
      <p class="label hero-label">PhD student · Robotics Research Center, IIIT Hyderabad</p>
      <h1 class="hero-name" id="hero-name"><span class="detect" data-chip="researcher 0.99 · id 07" data-name-detect>Shailendra Sekhar</span></h1>
      <p class="lead hero-lead">I work on autonomous driving: how cars perceive, plan and move through traffic they share with people who don't always follow the rules.</p>
      <ul class="links hero-links">
        <li><a href={`mailto:${site.email}`}>Email</a></li>
        {social.map((s) => <li><a href={s.href} target="_blank" rel="me noopener">{s.label}</a></li>)}
        <li><a href={site.cv}>CV</a></li>
      </ul>
      <div class="hero-cta">
        <button type="button" class="cta" data-start>Take the wheel</button>
        <p class="meta hero-live" data-hud-live>A live 3D town behind this page, not a video.</p>
      </div>
      <HeroDashcam />
    </div>
  </section>

  <div class="wrap">
    <hr class="lane-rule" data-reveal />

    <div class="two-col">
      <section class="section" aria-labelledby="news-h">
        <div class="section-head">
          <h2 class="label" id="news-h">News</h2>
        </div>
        <NewsList />
      </section>
      <section class="section" aria-labelledby="pub-h">
        <div class="section-head">
          <h2 class="label" id="pub-h">Selected publication</h2>
          <a class="meta" href="/research/">Research</a>
        </div>
        <PubList items={publications.slice(0, 1)} />
      </section>
    </div>
  </div>
</Base>

<script>
  const root = document.documentElement;
  let heroObserver: IntersectionObserver | null = null;

  document.addEventListener('astro:page-load', () => {
    const hero = document.querySelector<HTMLElement>('[data-town-hero]');
    if (!hero) return;
    const wide = matchMedia('(min-width: 900px)').matches;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Load three.js and the town only on wide screens, after the intro has handed over the page.
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    if (wide && !saveData) setTimeout(() => import('../scripts/drive'), root.dataset.intro ? 1700 : 0);

    // The side-lane car steps aside while the town fills the screen.
    heroObserver?.disconnect();
    heroObserver = new IntersectionObserver(([e]) => root.classList.toggle('hero-in-view', e.intersectionRatio > 0.35), { threshold: [0, 0.35, 1] });
    heroObserver.observe(hero);

    // On desktop, the name gets "detected" once after the page settles, as a hint that it can be hovered.
    const name = hero.querySelector<HTMLElement>('[data-name-detect]');
    if (!name || !wide || reduced) return;
    const delay = root.dataset.intro ? 3000 : 900;
    setTimeout(() => name.classList.add('on'), delay);
    setTimeout(() => name.classList.remove('on'), delay + 2200);
  });

  document.addEventListener('astro:before-swap', () => {
    heroObserver?.disconnect();
    heroObserver = null;
    root.classList.remove('hero-in-view');
  });
</script>

---
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import HeroDashcam from '../components/HeroDashcam.astro';
import NewsList from '../components/NewsList.astro';
import PubList from '../components/PubList.astro';
import { site, social } from '../data/site';
import { publications } from '../data/publications';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  alternateName: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: 'PhD student',
  affiliation: { '@type': 'Organization', name: 'Robotics Research Center, IIIT Hyderabad', url: 'https://robotics.iiit.ac.in/' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Georgia' },
    { '@type': 'CollegeOrUniversity', name: 'GITAM University' },
  ],
  knowsAbout: ['Autonomous driving', 'Robotics', 'Perception', 'Motion planning', 'Reinforcement learning', 'Behavior trees'],
  sameAs: social.map((s) => s.href),
};
---
<Base jsonLd={person}>
  <section class="hero wrap" aria-labelledby="hero-name">
    <p class="label hero-label">PhD student · Robotics Research Center, IIIT Hyderabad</p>
    <h1 class="hero-name" id="hero-name"><span class="detect" data-chip="researcher 0.99 · id 07" data-name-detect>Shailendra Sekhar</span></h1>
    <p class="lead hero-lead">I work on autonomous driving: how cars perceive, plan and move through traffic they share with people who don't always follow the rules.</p>
    <ul class="links hero-links">
      <li><a href={`mailto:${site.email}`}>Email</a></li>
      {social.map((s) => <li><a href={s.href} target="_blank" rel="me noopener">{s.label}</a></li>)}
      <li><a href={site.cv}>CV</a></li>
    </ul>
    <HeroDashcam />
    <HeroScene />
  </section>

  <div class="wrap">
    <hr class="lane-rule" data-reveal />

    <div class="two-col">
      <section class="section" aria-labelledby="news-h">
        <div class="section-head">
          <h2 class="label" id="news-h">News</h2>
        </div>
        <NewsList />
      </section>
      <section class="section" aria-labelledby="pub-h">
        <div class="section-head">
          <h2 class="label" id="pub-h">Selected publication</h2>
          <a class="meta" href="/research/">Research</a>
        </div>
        <PubList items={publications.slice(0, 1)} />
      </section>
    </div>

    <hr class="lane-rule" data-reveal />

    <section class="drive-teaser" data-reveal>
      <div>
        <h2 class="h2">Think you'd drive better than the auto-rickshaws?</h2>
        <p class="meta">A small 3D town with a signalled junction and four roundabouts, where red lights are optional, riders come the wrong way and pedestrians cross wherever they like. Drive it yourself or hand it to the autopilot.</p>
      </div>
      <a class="cta" href="/drive/">Take the wheel</a>
    </section>
  </div>
</Base>

<style>
  .drive-teaser { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-6); }
  .drive-teaser > div { display: flex; flex-direction: column; gap: var(--space-2); }
</style>

<script>
  // On desktop, the name gets "detected" once after the page settles, as a hint that it can be hovered.
  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector<HTMLElement>('[data-name-detect]');
    if (!el || !matchMedia('(min-width: 900px)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const delay = document.documentElement.dataset.intro ? 3000 : 900;
    setTimeout(() => el.classList.add('on'), delay);
    setTimeout(() => el.classList.remove('on'), delay + 2200);
  });
</script>

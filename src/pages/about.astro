---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import { site } from '../data/site';
import { builds, portrait, photos } from '../data/timeline';

const areas = ['Perception', 'Planning', 'Navigation', 'Multi-agent systems', 'Driver behaviour'];
// The LEGO shelf appears once there are real photos of builds.
const shelf = builds.filter((b) => b.src);

// Resized at build time: the portrait is never wider than 520px, the strip photos are a third of the page.
const shot = await getImage({ src: portrait.src, width: 1040, widths: [520, 1040], format: 'webp' });
const strip = await Promise.all(photos.map((p) => getImage({ src: p.src, width: 900, widths: [450, 900], format: 'webp' })));
---
<Base title="About" description="About Shailendra Sekhar: PhD student in autonomous driving at IIIT Hyderabad, movie buff, board gamer, occasional guitarist, new LEGO builder and hiker.">
  <div class="wrap about">
    <header class="with-margin head">
      <div class="page-head">
        <p class="label">About</p>
        <h1 class="h1">Hi, I'm Shailendra.</h1>
        <p class="lead">I'm a PhD student at the Robotics Research Center, IIIT Hyderabad, advised by Prof. K. Madhava Krishna. My work lives in autonomous driving, and like most PhD students I follow the interesting problems wherever they go.</p>
      </div>
      <figure class="figure headshot" data-reveal>
        <div class="figure-plate shot"><img src={shot.src} srcset={shot.srcSet.attribute} sizes="min(520px, 100vw)" alt={portrait.alt} width={portrait.src.width} height={portrait.src.height} /></div>
        <figcaption>{portrait.caption}</figcaption>
      </figure>
    </header>

    <hr class="lane-rule" data-reveal />

    <section class="section">
      <div class="prose" data-reveal>
        <h2 class="h2">What I work on</h2>
        <p>Autonomous driving is a stack of problems rather than one, and I work across it: perception, planning, navigation, multi-agent interaction, and analysing how drivers actually behave.</p>
        <p>What ties it together is that roads are shared with people, and people are hard to model. Most of us treat traffic law the way we treat Terms and Conditions: accepted, never read. So I lean on data. To borrow from Dr. House, <em>everybody lies</em>. Trajectories don't.</p>
        <ul class="tags" aria-label="Areas">
          {areas.map((a) => <li><span class="plate is-quiet">{a}</span></li>)}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="prose" data-reveal>
        <h2 class="h2">The road so far</h2>
        <p>Electronics and communication first, then data science, then AI and robotics, and now cars.</p>
      </div>
      <Timeline />
    </section>

    <section class="section">
      <div class="prose" data-reveal>
        <h2 class="h2">Off the clock</h2>
        <p>I'm a movie buff, and I still go looking for what's playing around the city. Board games take up more of my shelf than they should, the guitar is still on the deck, and I've recently started building LEGO. When I can get out of the city, I hike.</p>
      </div>
      <ul class="photos">
        {photos.map((p, i) => (
          <li data-reveal style={`--d: ${i * 90}ms`}>
            <figure class="figure">
              <div class="figure-plate photo"><img src={strip[i].src} srcset={strip[i].srcSet.attribute} sizes="(max-width: 760px) 100vw, 33vw" alt={p.alt} width={p.src.width} height={p.src.height} loading="lazy" decoding="async" /></div>
              <figcaption>{p.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
      {shelf.length > 0 && (
        <div class="shelf">
          <p class="label" data-reveal>On the build table</p>
          <ul class="builds">
            {shelf.map((b, i) => (
              <li data-reveal style={`--d: ${i * 80}ms`}>
                <figure class="figure">
                  <div class="figure-plate build"><img src={b.src} alt={b.name} loading="lazy" /></div>
                  <figcaption>{b.name}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>

    {site.contactKey && (
      <section class="section say-hello" id="contact">
        <div class="prose" data-reveal>
          <h2 class="h2">Say hello</h2>
          <p>Write to me about autonomous driving, a film I should see, a board game worth learning, or a good trail near Hyderabad.</p>
        </div>
        <!-- Sent by Web3Forms, which forwards it to my inbox. ui.ts posts it in place; without JS it posts the normal way. -->
        <form class="contact" action="https://api.web3forms.com/submit" method="POST" data-contact data-reveal>
          <input type="hidden" name="access_key" value={site.contactKey} />
          <input type="hidden" name="subject" value="New message from your website" />
          <input type="hidden" name="from_name" value={site.url.replace('https://', '')} />
          <input type="checkbox" name="botcheck" class="trap" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="row">
            <label class="field"><span class="label">Name</span><input type="text" name="name" autocomplete="name" maxlength="100" /></label>
            <label class="field"><span class="label">Your email</span><input type="email" name="email" autocomplete="email" maxlength="200" required /></label>
          </div>
          <label class="field"><span class="label">Message</span><textarea name="message" rows="6" maxlength="5000" required></textarea></label>
          <div class="send">
            <button type="submit" class="cta">Send</button>
            <p class="meta" role="status" data-contact-status></p>
          </div>
        </form>
      </section>
    )}
  </div>
</Base>

<style>
  .about { display: flex; flex-direction: column; gap: var(--space-16); }
  .about .lane-rule { margin: 0; }
  /* The portrait is shown whole (it's nearly square), so it gets a wider column than a headshot would. */
  .head { align-items: center; padding-top: var(--space-8); grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
  .headshot { max-width: 520px; justify-self: end; width: 100%; }
  .shot img { width: 100%; height: auto; }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .photos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .photo { aspect-ratio: 3 / 4; }
  .photos li:hover img { transform: scale(1.03); }
  .photo img { transition: transform .8s var(--ease-drive); }
  .shelf { display: flex; flex-direction: column; gap: var(--space-4); }
  .builds { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
  .build { aspect-ratio: 4 / 3; display: grid; place-items: center; }
  .build img { width: 100%; height: 100%; object-fit: cover; }
  .contact { display: grid; gap: var(--space-4); max-width: 48rem; }
  .contact .row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .field { display: grid; gap: var(--space-2); }
  .field input, .field textarea { width: 100%; font-family: var(--font-display); font-size: var(--fs-small); line-height: 1.5; color: var(--ink); background: var(--paper-raised); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: var(--space-3); transition: border-color .2s; }
  .field textarea { resize: vertical; min-height: 10em; }
  .field :is(input, textarea):hover { border-color: var(--ink-faint); }
  .field :is(input, textarea):focus-visible { outline: 2px solid var(--lane-ink); outline-offset: 0; border-color: transparent; }
  .trap { display: none; }
  .send { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-6); margin-top: var(--space-2); }
  .send .cta:disabled { opacity: .6; cursor: progress; transform: none; }
  [data-contact-status][data-state="ok"] { color: var(--lane-ink); }
  [data-contact-status][data-state="error"] { color: var(--ink); }
  @media (max-width: 900px) {
    .head { grid-template-columns: 1fr; }
    .headshot { justify-self: start; max-width: 520px; }
  }
  @media (max-width: 760px) {
    .builds { grid-template-columns: 1fr 1fr; }
    .photos { grid-template-columns: 1fr; gap: var(--space-8); }
    .contact .row { grid-template-columns: 1fr; }
  }
</style>

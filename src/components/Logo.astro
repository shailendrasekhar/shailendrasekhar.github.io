---
// The mark: an S-shaped road. Its two kerb lines are the two S's of the initials,
// the amber dashes are the lane line, and an amber car can drive it (see scripts/ui.ts).
interface Props {
  id: string;
  size?: number;
  class?: string;
}
const { id, size = 34, class: className = '' } = Astro.props;
const ROAD ='M46 14 C 41 8, 20 8, 20 20 C 20 31, 44 29, 44 42 C 44 55, 22 56, 16 49';
---
<svg class={`logo ${className}`} viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" focusable="false">
  <defs>
    <mask id={`${id}-kerb`} maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64">
      <rect width="64" height="64" fill="white"></rect>
      <path d={ROAD} fill="none" stroke="black" stroke-width="7"></path>
    </mask>
    <path id={`${id}-path`} d={ROAD}></path>
  </defs>
  <path class="logo-road" d={ROAD} fill="none" stroke="currentColor" stroke-width="12" mask={`url(#${id}-kerb)`} pathLength="100"></path>
  <path class="logo-lane" d={ROAD} fill="none" stroke="var(--lane)" stroke-width="1.8" stroke-dasharray="3 4"></path>
  <g class="logo-car">
    <rect x="-3.2" y="-1.9" width="6.4" height="3.8" rx="1" fill="var(--lane)"></rect>
    <animateMotion dur="0.9s" begin="indefinite" fill="freeze" rotate="auto" keyPoints="0;1" keyTimes="0;1" calcMode="spline" keySplines=".6 0 .3 1">
      <mpath href={`#${id}-path`}></mpath>
    </animateMotion>
  </g>
</svg>
